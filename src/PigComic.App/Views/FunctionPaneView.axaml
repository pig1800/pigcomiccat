<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PigComic.App.ViewModels"
             xmlns:controls="using:PigComic.App.Controls"
             xmlns:views="using:PigComic.App.Views"
             x:Class="PigComic.App.Views.FunctionPaneView"
             x:DataType="vm:FunctionPaneViewModel">
    <DockPanel>
        <!-- LLM comment -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="3" Margin="12,6,12,4"
                    IsVisible="{Binding HasLlmComment}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear" FontSize="11" Padding="8,1"
                        Click="OnClearLlmClick" ToolTip.Tip="Clear the LLM comment"/>
                <TextBlock Text="LLM comment" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding LlmComment}" TextWrapping="Wrap" FontSize="12"
                       Foreground="#883366" Background="#14E3F2FD" Padding="6,3"/>
        </StackPanel>

        <!-- Notes -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="3" Margin="12,4,12,4">
            <TextBlock Text="Notes" FontSize="11" Foreground="Gray"/>
            <controls:PartTextEditor x:Name="NotesField" Text="{Binding Notes, Mode=TwoWay}"
                                     MultiLine="True" EnterInsertsNewline="True"
                                     MinHeight="44" MaxHeight="96" FontSize="12"
                                     Watermark="Translator notes…"/>
        </StackPanel>

        <!-- Character box -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="12,6,12,4">
            <DockPanel IsVisible="{Binding Characters.HasMasterOffer}">
                <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right">
                    <Button Content="Add" FontSize="11" Padding="8,1" Click="OnOfferAddClick"/>
                    <Button Content="Not now" FontSize="11" Padding="8,1" Click="OnOfferDismissClick"/>
                </StackPanel>
                <TextBlock Text="{Binding Characters.MasterOfferName, StringFormat=Add 『{0}』 to master list?}"
                           FontSize="12" VerticalAlignment="Center" Foreground="#7A5B00"/>
            </DockPanel>

            <TextBlock Text="Character" FontSize="11" Foreground="Gray"/>
            <controls:PartTextEditor x:Name="CharacterField" FontSize="13" Watermark="Type a name…"
                                     Text="{Binding Characters.Query, Mode=TwoWay}"
                                     KeyDown="OnCharacterKeyDown" GotFocus="OnCharacterGotFocus"/>
            <ListBox x:Name="SuggestionsBox" ItemsSource="{Binding Characters.Suggestions}"
                     SelectedItem="{Binding Characters.SelectedName, Mode=TwoWay}"
                     MaxHeight="110" MinHeight="0" Margin="0"
                     IsVisible="{Binding Characters.SuggestionsVisible}"
                     Background="#FEFEFE"
                     DoubleTapped="OnSuggestionTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" FontSize="13" Padding="4,2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Apply" FontSize="11" Padding="8,1"
                        Click="OnCharacterApplyClick"/>
                <Button x:Name="OpenMasterButton" DockPanel.Dock="Right" Content="Master…" FontSize="11" Padding="8,1"
                        Click="OnOpenMasterClick" ToolTip.Tip="Open the master character editor (Ctrl+Shift+M)"/>
                <TextBlock Text="Chapter characters:" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
            </DockPanel>
            <WrapPanel x:Name="ChapterButtonHost" Margin="0,2,0,0">
                <Button Content="✕ Clear" FontSize="12" Padding="8,2" Margin="0,2,6,0"
                        Click="OnEraseCharacterClick" ToolTip.Tip="Clear the selected bubble's speaker"/>
                <ItemsControl x:Name="ChapterButtons" ItemsSource="{Binding Characters.ChapterNames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <ToggleButton Content="{Binding}" FontSize="12" Padding="8,2" Margin="0,2,6,0"
                                          Click="OnChapterNameClick">
                                <ToggleButton.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Remove from chapter list"
                                                   Click="OnRemoveChapterNameClick"/>
                                    </ContextMenu>
                                </ToggleButton.ContextMenu>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
        </StackPanel>

        <!-- Kind selector + custom textbox (BELOW character info) -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="3" Margin="12,4,12,6">
            <TextBlock Text="Kind" FontSize="11" Foreground="Gray"/>
            <WrapPanel x:Name="KindButtons">
                <ToggleButton x:Name="KindSpeech" Content="Speech" Tag="Speech" Margin="0,0,4,4" IsCheckedChanged="OnKindToggle"/>
                <ToggleButton x:Name="KindThought" Content="Thought" Tag="Thought" Margin="0,0,4,4" IsCheckedChanged="OnKindToggle"/>
                <ToggleButton x:Name="KindNarration" Content="Narration" Tag="Narration" Margin="0,0,4,4" IsCheckedChanged="OnKindToggle"/>
                <ToggleButton x:Name="KindSfx" Content="SFX" Tag="Sfx" Margin="0,0,4,4" IsCheckedChanged="OnKindToggle"/>
                <ToggleButton x:Name="KindSign" Content="Sign" Tag="Sign" Margin="0,0,4,4" IsCheckedChanged="OnKindToggle"/>
                <ToggleButton x:Name="KindNote" Content="Note" Tag="Note" Margin="0,0,4,4" IsCheckedChanged="OnKindToggle"/>
                <controls:PartTextEditor x:Name="KindCustom" Text="{Binding Kind, Mode=TwoWay}" FontSize="12"
                                         Watermark="Custom…" EnterInsertsNewline="False" MinWidth="80"
                                         Margin="0,0,0,4" VerticalAlignment="Center"/>
            </WrapPanel>
        </StackPanel>

        <!-- Character info (read-only, ABOVE Kind) -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="12,4,12,4"
                    IsVisible="{Binding HasCharacterInfo}">
            <TextBlock Text="Character info" FontSize="11" Foreground="Gray"/>
            <Border Background="#0A000000" BorderBrush="#22000000" BorderThickness="0,0,0,1" Padding="6,4">
                <Grid ColumnDefinitions="75,120,65,120" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Original" FontSize="11" Foreground="Gray" Margin="0,1,4,1"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCharacterInfo.Original}" FontSize="12" TextWrapping="Wrap" Margin="0,1,12,1"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Gender" FontSize="11" Foreground="Gray" Margin="0,1,4,1"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedCharacterInfo.Gender}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,1"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Localized" FontSize="11" Foreground="Gray" Margin="0,1,4,1"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCharacterInfo.Localized}" FontSize="12" TextWrapping="Wrap" Margin="0,1,12,1"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Age" FontSize="11" Foreground="Gray" Margin="0,1,4,1"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedCharacterInfo.Age}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,1"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pronounced" FontSize="11" Foreground="Gray" Margin="0,1,4,1"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCharacterInfo.Pronunciation}" FontSize="12" TextWrapping="Wrap" Margin="0,1,12,1"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Chapter" FontSize="11" Foreground="Gray" Margin="0,1,4,1"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedCharacterInfo.Chapter}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,1"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Pronoun" FontSize="11" Foreground="Gray" Margin="0,1,4,1"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCharacterInfo.Pronoun}" FontSize="12" TextWrapping="Wrap" Margin="0,1,12,1"/>
                </Grid>
            </Border>
            <TextBlock Text="Comments" FontSize="11" Foreground="Gray" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding SelectedCharacterInfo.Comments}" FontSize="12" TextWrapping="Wrap"
                       Foreground="Black"/>
        </StackPanel>

        <Border BorderBrush="#22000000" BorderThickness="0,1,0,0" Background="#08000000">
            <views:MatchListView DataContext="{Binding Matches}"/>
        </Border>
    </DockPanel>
</UserControl>
