<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PigComic.App.Views.RelinkDialog"
        Title="Relink missing chapters" Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="The following chapter files are missing. Browse for each one, or search one folder to resolve all by file name." TextWrapping="Wrap"/>
        <Border x:Name="MissingListHost" BorderBrush="Gray" BorderThickness="1" Padding="8" MaxHeight="300">
            <StackPanel x:Name="RowsPanel" Spacing="6"/>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Search folder…" Click="OnSearchFolderClick"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="OnCancelClick" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Click="OnOkClick" IsDefault="True" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>