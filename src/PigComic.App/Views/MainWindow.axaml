<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PigComic.App.ViewModels"
        x:Class="PigComic.App.Views.MainWindow"
        x:DataType="vm:ProjectListViewModel"
        Title="PigComic" Width="1000" Height="700">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Debug (M2 only)">
                <MenuItem Header="Spike: tiled canvas" Click="OnSpikeClick"/>
                <MenuItem Header="IME gate test" Click="OnImeClick"/>
            </MenuItem>
        </Menu>

        <DockPanel DockPanel.Dock="Top" Margin="12">
            <TextBlock Text="Projects" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" DockPanel.Dock="Right">
                <Button x:Name="OpenButton" Content="Open…" Click="OnOpenClick"/>
                <Button x:Name="CreateButton" Content="Create…" Classes="accent" Click="OnCreateClick"/>
            </StackPanel>
        </DockPanel>

        <Border Margin="12" CornerRadius="6" Background="#0FFFFFFF" Padding="0">
            <ListBox x:Name="ProjectList"
                     ItemsSource="{Binding Projects}"
                     KeyDown="OnListKeyDown"
                     DoubleTapped="OnListDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" Margin="6">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="Gray"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Remove…" Click="OnRemoveClick"
                                    Tag="{Binding ProjectJsonPath}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>