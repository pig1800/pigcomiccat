<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PigComic.App.Controls"
        x:Class="PigComic.App.Views.CreateProjectDialog"
        Title="Create project" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="10">
        <StackPanel Spacing="4">
            <TextBlock Text="Title *"/>
            <controls:PartTextEditor x:Name="TitleBox" TextChanged="OnFieldChanged" ConfirmOnEnter="False"/>
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Folder * (must be empty or nonexistent; created if missing)"/>
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <controls:PartTextEditor x:Name="FolderBox" Grid.Column="0" TextChanged="OnFieldChanged" ConfirmOnEnter="False"/>
                <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseClick"/>
            </Grid>
        </StackPanel>
        <Grid ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,5,0">
                <TextBlock Text="Source language"/>
                <!-- Defaults to zh-CN -> ja, the owner's normal direction (D-51). -->
                <ComboBox x:Name="SourceCombo" SelectedIndex="0">
                    <ComboBoxItem Content="zh-CN"/>
                    <ComboBoxItem Content="zh-TW"/>
                    <ComboBoxItem Content="ja"/>
                    <ComboBoxItem Content="ko"/>
                    <ComboBoxItem Content="en"/>
                    <ComboBoxItem Content="(free text)"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4" Margin="5,0,0,0">
                <TextBlock Text="Target language"/>
                <ComboBox x:Name="TargetCombo" SelectedIndex="0">
                    <ComboBoxItem Content="ja"/>
                    <ComboBoxItem Content="zh-CN"/>
                    <ComboBoxItem Content="zh-TW"/>
                    <ComboBoxItem Content="ko"/>
                    <ComboBoxItem Content="en"/>
                    <ComboBoxItem Content="(free text)"/>
                </ComboBox>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="OnCancelClick" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Create" IsDefault="True" Click="OnOkClick" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>