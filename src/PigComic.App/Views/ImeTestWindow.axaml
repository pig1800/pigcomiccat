<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PigComic.App.Controls"
        x:Class="PigComic.App.Views.ImeTestWindow"
        Title="PigComic — IME gate (M2.5)"
        Width="900" Height="640">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Text="IME test: the guard below is the exact handler the target editor will use in M5."
                       Margin="8,6" FontStyle="Italic"/>
        </DockPanel>

        <Grid ColumnDefinitions="*,*" Margin="8">
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Single-line editor (composition Enter guard active)" FontWeight="SemiBold"/>
                <controls:PartTextEditor x:Name="Single" Text="日本語テスト" Height="34" MultiLine="False"/>
                <TextBlock Text="Multi-line target editor simulation (Enter = confirm, Shift+Enter = newline)" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <controls:PartTextEditor x:Name="Multi" Height="140" MultiLine="True"/>
                <TextBlock Text="Reference: centered TextBox (NOT PartTextEditor) — for comparison only; its preedit caret may misalign."
                           FontStyle="Italic" Margin="0,12,0,0"/>
                <TextBox x:Name="CenteredReference" Text="比較用" Height="34" TextAlignment="Center"
                         VerticalContentAlignment="Center"/>
                <TextBlock x:Name="Log" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0">
                <TextBlock Text="SPEC §21 checklist — tick after verifying with JA (MS IME) and KO input" FontWeight="SemiBold"/>
                <CheckBox Content="1. JA: romaji → hiragana at the caret; Space shows candidates; Enter commits; no dropped chars" x:Name="Check1"/>
                <CheckBox Content="2. JA: composition inside existing text inserts correctly" x:Name="Check2"/>
                <CheckBox Content="3. KO: 2-beolsik jamo assembles in place; commit/backspace like Notepad" x:Name="Check3"/>
                <CheckBox Content="4. Shift+Enter during composition does not break composition state; Enter during
                               composition never confirms (watch log below)" x:Name="Check4"/>
                <CheckBox Content="5. IME on/off toggling works while the control is focused" x:Name="Check5"/>
                <CheckBox Content="6. Modern rendering (SPEC §21.2): composition text is COLOURED (not underlined)
                               with the caret visible inside it; after Space, the active henkan clause shows a
                               COLOURED BACKGROUND that moves with ←/→. Verify with BOTH MS-IME JA and ATOK." x:Name="Check6"/>
                <TextBlock Text="Confirm log:" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <TextBlock x:Name="ConfirmLog" TextWrapping="Wrap"/>

                <TextBlock Text="IMM32 diagnostics (PLAN M2.6)" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <TextBlock x:Name="HookStatus" TextWrapping="Wrap" FontSize="11"/>
                <CheckBox x:Name="CaptureToggle" Content="Capture clause data in-message (uncheck to A/B against the old behaviour)"
                          IsCheckedChanged="OnCaptureToggled"/>
                <CheckBox x:Name="DiagToggle" Content="Log every composition message to a file"
                          IsCheckedChanged="OnDiagToggled"/>
                <TextBlock x:Name="DiagPath" TextWrapping="Wrap" FontSize="11" Foreground="Gray"/>
                <TextBlock x:Name="DiagStatus" TextWrapping="Wrap" FontSize="11"/>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <Button Content="Summarise log" Click="OnSummariseDiag"/>
                    <Button Content="Clear log" Click="OnClearDiag"/>
                </StackPanel>
                <TextBlock Text="Turn on, compose one JA session per IME (type kana → Space → ←/→ → Enter), then
                                 Summarise. Non-zero clause/attr byte counts mean IMM32 is delivering henkan data."
                           TextWrapping="Wrap" FontSize="11" FontStyle="Italic" Foreground="Gray"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>