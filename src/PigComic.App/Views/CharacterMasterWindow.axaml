<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PigComic.App.ViewModels"
        xmlns:controls="using:PigComic.App.Controls"
        x:Class="PigComic.App.Views.CharacterMasterWindow"
        x:DataType="vm:CharacterMasterViewModel"
        Title="Master characters" Width="1040" Height="640" MinWidth="820" MinHeight="420">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="10,8,10,6">
            <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Right">
                <Button x:Name="AddButton" Content="＋ Add character" Click="OnAddClick"/>
                <Button x:Name="DoneButton" Content="Done" Classes="accent" Click="OnDoneClick"/>
            </StackPanel>
            <TextBlock Text="Select a row and press Ctrl+V to paste a portrait (PNG, ≤256×256)."
                       Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding DuplicateMessage}" Foreground="IndianRed"
                   Margin="10,0,10,4" FontWeight="SemiBold" IsVisible="{Binding HasDuplicate}"/>
        <ListBox x:Name="RowList" ItemsSource="{Binding Rows}" Background="Transparent" Margin="4"
                KeyboardNavigation.TabNavigation="Cycle">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CharacterMasterRowViewModel">
                    <Border BorderBrush="#22000000" BorderThickness="0,0,0,1" Padding="4,6">
                        <Grid ColumnDefinitions="150,150,150,110,70,70,110,110,*,32">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                <TextBlock Text="Original" FontSize="11" Foreground="Gray"/>
                                <controls:PartTextEditor Text="{Binding Name, Mode=TwoWay}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,8,0">
                                <TextBlock Text="Localized" FontSize="11" Foreground="Gray"/>
                                <controls:PartTextEditor Text="{Binding Localized, Mode=TwoWay}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2" Margin="0,0,8,0">
                                <TextBlock Text="Pronunciation" FontSize="11" Foreground="Gray"/>
                                <controls:PartTextEditor Text="{Binding Pronunciation, Mode=TwoWay}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="2" Margin="0,0,8,0">
                                <TextBlock Text="Image" FontSize="11" Foreground="Gray"/>
                                <Border BorderBrush="#33000000" BorderThickness="1" Width="72" Height="54"
                                        Background="#14000000" HorizontalAlignment="Left">
                                    <Image Source="{Binding ImagePreview}" Stretch="Uniform" MaxWidth="68" MaxHeight="50"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Content="Paste" FontSize="11" Padding="6,1" Click="OnPasteClick"/>
                                    <Button Content="Browse…" FontSize="11" Padding="6,1" Click="OnBrowseClick"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="2" Margin="0,0,8,0">
                                <TextBlock Text="Gender" FontSize="11" Foreground="Gray"/>
                                <controls:PartTextEditor Text="{Binding Gender, Mode=TwoWay}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5" Spacing="2" Margin="0,0,8,0">
                                <TextBlock Text="Age" FontSize="11" Foreground="Gray"/>
                                <controls:PartTextEditor Text="{Binding Age, Mode=TwoWay}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6" Spacing="2" Margin="0,0,8,0">
                                <TextBlock Text="First chapter" FontSize="11" Foreground="Gray"/>
                                <controls:PartTextEditor Text="{Binding FirstChapter, Mode=TwoWay}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="7" Spacing="2" Margin="0,0,8,0">
                                <TextBlock Text="Pronoun" FontSize="11" Foreground="Gray"/>
                                <controls:PartTextEditor Text="{Binding Pronoun, Mode=TwoWay}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="8" Spacing="2" Margin="0,0,8,0">
                                <TextBlock Text="Comments" FontSize="11" Foreground="Gray"/>
                                <controls:PartTextEditor Text="{Binding Comments, Mode=TwoWay}" FontSize="13" MultiLine="True" MinHeight="46"/>
                            </StackPanel>
                            <Button Grid.Column="9" Content="✕" VerticalAlignment="Center" FontSize="12"
                                    Click="OnDeleteClick" ToolTip.Tip="Delete row"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
