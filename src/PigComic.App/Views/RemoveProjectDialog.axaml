<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PigComic.App.Views.RemoveProjectDialog"
        Title="Remove project" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock x:Name="Hint" TextWrapping="Wrap" Foreground="Gray"/>
        <RadioButton x:Name="ListOnlyRadio" Content="Remove from list only (keep folder)" IsChecked="True"
                     GroupName="mode" IsCheckedChanged="OnModeChanged"/>
        <RadioButton x:Name="DeleteRadio" Content="Delete project folder from disk (permanent, no recycle bin — D-08)"
                     GroupName="mode" IsCheckedChanged="OnModeChanged"/>
        <CheckBox x:Name="ConfirmDelete" Content="I understand this permanently deletes the folder"
                  IsEnabled="False" IsChecked="False"/>
        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="OnCancelClick" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Click="OnOkClick" IsDefault="True" IsEnabled="True"/>
        </StackPanel>
    </StackPanel>
</Window>